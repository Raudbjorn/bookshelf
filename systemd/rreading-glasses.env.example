# rreading-glasses environment configuration
# Copy to /etc/rreading-glasses/rreading-glasses.env and configure
#
# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rreading_glasses
POSTGRES_USER=rreading_glasses
POSTGRES_PASSWORD=changeme_secure_password

# API Configuration
PORT=8788

# Optional: API keys if using authenticated sources
# HARDCOVER_API_KEY=your_api_key_here
# GOODREADS_API_KEY=your_api_key_here
